{
  "name": "xi-configs",
  "version": "0.1.0",
  "description": "Shared ESLint, Prettier, and TypeScript configurations",
  "author": "Kevin Izuchukwu",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andthexi/configs.git"
  },
  "homepage": "https://github.com/andthexi/configs#readme",
  "bugs": {
    "url": "https://github.com/andthexi/configs/issues"
  },
  "files": [
    "eslint",
    "prettier",
    "tsconfig",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    "./prettier": "./prettier/index.json",
    "./tsconfig/node-app": "./tsconfig/node-app.json",
    "./tsconfig/node-app-native": "./tsconfig/node-app-native.json",
    "./tsconfig/node-library": "./tsconfig/node-library.json",
    "./tsconfig/node-library-tsc": "./tsconfig/node-library-tsc.json",
    "./tsconfig/node-library-ts-source": "./tsconfig/node-library-ts-source.json",
    "./tsconfig/vite": "./tsconfig/vite.json",
    "./tsconfig/vite-vue": "./tsconfig/vite-vue.json",
    "./tsconfig/vite-react": "./tsconfig/vite-react.json",
    "./eslint/js": "./eslint/js.mjs",
    "./eslint/ts": "./eslint/ts.mjs",
    "./eslint/node-js": "./eslint/node-js.mjs",
    "./eslint/node-ts": "./eslint/node-ts.mjs",
    "./eslint/browser-js": "./eslint/browser-js.mjs",
    "./eslint/browser-ts": "./eslint/browser-ts.mjs",
    "./eslint/vue-js": "./eslint/vue-js.mjs",
    "./eslint/vue-ts": "./eslint/vue-ts.mjs"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/config-inspector": "3.5.0",
    "eslint": "10.14.0",
    "husky": "^9.1.7",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eslint": ">=10 <11",
    "prettier": ">=3 <4",
    "typescript": ">=4.8.4 <6.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2",
    "vue-eslint-parser": "10.4.2"
  }
}
